# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/blastbeast
DB_USER=blastbeast
DB_PASSWORD=blastbeast

# URLs
SITE_BASE_URL=http://localhost:4200

# Seguridad (M2). Genera una con: openssl rand -base64 48
JWT_SECRET=
# 15 minutos de access token y 30 días de refresco (ISO-8601)
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
AUTH_COOKIE_NAME=bb_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
# Límite de intentos fallidos de login (por IP + email y por IP).
AUTH_LOGIN_WINDOW=PT15M
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20

# Almacenamiento de imágenes (M2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_LOCAL_ROOT=./data/media
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/media
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_THUMB_WIDTH=480
STORAGE_HERO_WIDTH=1600

# CSV interno de contactos de prensa e imagen (solo se sirve con sesión).
# En Docker se monta docs/ en /app/docs; esta ruta es la del contenedor.
PRESS_CONTACTS_CSV_PATH=../docs/contactos-prensa-e-imagenes.csv

# Bootstrap del primer ADMIN si no hay usuarios
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Redacción Blast Beast

# Agenda de conciertos (Ticketmaster)
# Crea una clave gratuita en https://developer.ticketmaster.com/
TICKETMASTER_ENABLED=false
TICKETMASTER_API_KEY=
TICKETMASTER_SYNC_CRON=0 0 */6 * * *
TICKETMASTER_SYNC_DAYS=180
