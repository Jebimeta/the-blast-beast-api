# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/blastbeast
DB_USER=blastbeast
DB_PASSWORD=blastbeast

# URLs
SITE_BASE_URL=http://localhost:4200

# Seguridad (M2). Genera una con: openssl rand -base64 48
JWT_SECRET=
# 15 minutos de access token y 30 días de refresco (ISO-8601)
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
AUTH_COOKIE_NAME=bb_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=

# Almacenamiento de imágenes (M2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_LOCAL_ROOT=./data/media
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/media
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_THUMB_WIDTH=480
STORAGE_HERO_WIDTH=1600

# Bootstrap del primer ADMIN si no hay usuarios
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Redacción Blast Beast
